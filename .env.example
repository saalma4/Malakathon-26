# Copy to .env (git-ignored) and fill in. In GitHub Actions these are repository secrets.
# <PREFIX> = COM (betsson.com), PE (betsson.pe), ES (betsson.es dev container)

# Funded account (Scenario 1)
COM_FUNDED_USER=
COM_FUNDED_PASS=
PE_FUNDED_USER=
PE_FUNDED_PASS=
ES_FUNDED_USER=
ES_FUNDED_PASS=

# Account with no usable balance (Scenario 2)
COM_EMPTY_USER=
COM_EMPTY_PASS=
PE_EMPTY_USER=
PE_EMPTY_PASS=
ES_EMPTY_USER=
ES_EMPTY_PASS=

# Optional: proxy per market if the site geo-redirects (e.g. http://user:pass@host:port)
COM_PROXY=
PE_PROXY=

# Optional: override the game per market (path must open the game in Real Play)
# COM_GAME_PATH=/en/casino/game/sweet-bonanza?gameAction=play
# COM_GAME_KEY=sweet-bonanza

# Optional: precise locator for the Betsson balance in the header
# COM_BALANCE_SELECTOR=[data-testid="balance"]

# Debug: HEADED=1 shows the browser, TRACE=on records Playwright traces (contain session cookies: never publish)
# HEADED=1
# TRACE=on
